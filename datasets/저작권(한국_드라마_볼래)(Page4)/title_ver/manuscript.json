    "text044": {
        "type": "text",
        "content": "무료"
    },
    "text045": {
        "type": "text",
        "content": "무료"
    },
    "text046": {
        "type": "text",
        "content": "• 요금이 없음"
    },
    "text047": {
        "type": "text",
        "content": "• 급료가 없음"
    },
    "text048": {
        "type": "text",
        "content": "예"
    },
    "text049": {
        "type": "text",
        "content": "창간호를 홍보 차원에서 무료 배포 합니다."
    },
    "text050": {
        "type": "text",
        "content": "이번 공연에는 유명한 성악가들이 무료로 출연한다고 한다."
    },
    "text051": {
        "type": "text",
        "content": "무료 로 다운로드해서 볼 수 있어요!"
    },
    "text052": {
        "type": "text",
        "content": "You can download and view it for free!"
    },
